# ============================================================
# 전국 로또 지도 통계 플랫폼 - 환경 변수 템플릿
# ============================================================
# 각 섹션별로 값을 채운 후 .env로 복사해서 사용하세요.
# IMPORTANT: .env 파일은 Git에 커밋하지 말 것 (민감한 정보 보호)

# ============================================================
# Supabase (앱 클라이언트용 - 공개 가능)
# ============================================================
# https://app.supabase.com → 프로젝트 선택 → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...YOUR_ANON_KEY...

# ============================================================
# Naver Map (클라이언트 - 앱 번들에 포함)
# ============================================================
# https://console.ncloud.com → AI·Application Service → Naver Map
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=YOUR_CLIENT_ID

# ============================================================
# Sentry (에러 추적 - 선택사항)
# ============================================================
# https://sentry.io → 프로젝트 생성 후 DSN 복사
# 미설정 시 자동으로 비활성화됨
EXPO_PUBLIC_SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/YOUR_PROJECT_ID

# ============================================================
# PostHog (사용자 분석 - 선택사항)
# ============================================================
# https://posthog.com → 프로젝트 생성 후 API Key 복사
# 미설정 시 자동으로 비활성화됨
EXPO_PUBLIC_POSTHOG_API_KEY=YOUR_POSTHOG_API_KEY

# ============================================================
# Supabase (서버/배치 전용 - 절대 공개 금지!)
# ============================================================
# https://app.supabase.com → 프로젝트 선택 → Settings → API
# "service_role" 키 (쓰기 권한 있음)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...YOUR_SERVICE_ROLE_KEY...

# ============================================================
# 공공데이터포털 (판매점 데이터 수집)
# ============================================================
# https://www.data.go.kr → 회원가입 → "복권 판매점 현황" API 신청
# API 활용신청 후 발급받은 인증키
DATA_GO_KR_API_KEY=YOUR_DATA_GO_KR_API_KEY

# ============================================================
# Naver Cloud Platform (지오코딩 - 서버 배치용)
# ============================================================
# https://console.ncloud.com → AI·Application Service → Naver Map
# 두 개의 키를 발급받아야 합니다:
# 1. Client ID (앱과 동일한 값 가능)
# 2. Client Secret (앱에는 절대 포함하지 않음)
NAVER_MAP_CLIENT_ID=YOUR_NAVER_CLIENT_ID
NAVER_MAP_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET

# ============================================================
# GitHub Actions (CI/CD - 배포 자동화)
# ============================================================
# 아래 값들은 GitHub Secrets에만 설정하고 이 파일에는 입력하지 말 것
# - SUPABASE_SERVICE_ROLE_KEY
# - DATA_GO_KR_API_KEY
# - NAVER_MAP_CLIENT_SECRET
# - EXPO_CLASSIC_TOKEN (EAS Build용 - 선택사항)

# ============================================================
# 개발 환경 설정 (선택사항)
# ============================================================
# 로컬 개발 시 Supabase 대신 로컬 인스턴스 사용하려면:
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=eyJ...local_key...
